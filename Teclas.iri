handler N0Keypressed;
begin
    if PantallaActual = PantallaPrincipal then
        DisplayStatus("Vacio");
    elsif PantallaActual = PantallaVelocidad then
        DisplayStatus("Pantalla Presentacion");
    end if;
end;

handler N1Keypressed;
begin
    if PantallaActual = PantallaPrincipal then
        ZeroScale(1);
    elsif PantallaActual = PantallaVelocidad then
        Temporizador(9, VOn, TimerOneShot, Config[1].TActivacion); 
    elsif PantallaActual = PantallaCalibracion then
        ApagarTemporizador(1);  
        DisplayStatus("Bascula 1 Apagada");
    end if;
end;

handler N2Keypressed;
begin
    if PantallaActual = PantallaPrincipal then
        ZeroScale(2);
    elsif PantallaActual = PantallaVelocidad then
        Temporizador(14, VOn, TimerOneShot, Config[2].TActivacion);
    elsif PantallaActual = PantallaCalibracion then
        ApagarTemporizador(2);
        DisplayStatus("Bascula 2 Apagada");
    end if;
end;

handler N3Keypressed;
begin
    if PantallaActual = PantallaPrincipal then
        ZeroScale(3);
    elsif PantallaActual = PantallaVelocidad then
        Temporizador(19, VOn, TimerOneShot, Config[3].TActivacion);
    elsif PantallaActual = PantallaCalibracion then
        ApagarTemporizador(3);
        DisplayStatus("Bascula 3 Apagada");
    end if;
end;

handler N4Keypressed;
begin
    if PantallaActual = PantallaPrincipal then
        ZeroScale(4);
    elsif PantallaActual = PantallaVelocidad then
        Temporizador(24, VOn, TimerOneShot, Config[4].TActivacion);
    elsif PantallaActual = PantallaCalibracion then
        ApagarTemporizador(4);   
        DisplayStatus("Bascula 4 Apagada");
    end if;
end;

handler N5Keypressed;
begin
    if PantallaActual = PantallaPrincipal then
        BotarPollo(1);
    elsif PantallaActual = PantallaVelocidad then
            DisplayStatus("Vacio");
    elsif PantallaActual = PantallaCalibracion then
        EncenderTemporizador(1);  
        DisplayStatus("Bascula 1 Encendida");
    end if;
end;

handler N6Keypressed;
begin
    if PantallaActual = PantallaPrincipal then
        BotarPollo(2);
    elsif PantallaActual = PantallaVelocidad then
         DisplayStatus("Vacio");
    elsif PantallaActual = PantallaCalibracion then
        EncenderTemporizador(2);   
        DisplayStatus("Bascula 2 Encendida");
    end if;
end;

handler N7Keypressed;
begin
    if PantallaActual = PantallaPrincipal then
        BotarPollo(3);
    elsif PantallaActual = PantallaVelocidad then
         DisplayStatus("Vacio");
        EncenderTemporizador(3);  
        DisplayStatus("Bascula 3 Encendida");
    end if;
end;

handler N8Keypressed;
begin
    if PantallaActual = PantallaPrincipal then
        BotarPollo(4);
    elsif PantallaActual = PantallaVelocidad then
         DisplayStatus("Vacio");
    elsif PantallaActual = PantallaCalibracion then
        EncenderTemporizador(4); 
        DisplayStatus("Bascula 4 Encendida");
    end if;
end;


handler N9Keypressed;
begin
    if PantallaActual = PantallaPrincipal then
        Temporizador(18, VOn, TimerContinuous, 10);
    elsif PantallaActual = PantallaVelocidad then
         DisplayStatus("Vacio");
    end if;
end;
