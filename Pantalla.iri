procedure ActualizarData(Pantalla : integer);
begin
  if pantalla = PantallaPrincipal then   
        --InitPollito;
        --DrawGraphic(1, 250, 10, g_r,Black);
        SetSoftkeyText(1,"Aj. Bascula");
        SetSoftkeyText(2,"Aj. Piston");
        SetSoftkeyText(3,"Pruebas");
        SetSoftkeyText(4,"Limpiar");
        SetSoftkeyText(5,"Salir");
           
  elsif pantalla = PantallaInicio then      
        SetSoftkeyText(1,"Cal. Cero");
        SetSoftkeyText(2,"Cal. Rodo");
        SetSoftkeyText(3,"P. Tara");
        SetSoftkeyText(4,"P. con Peso");
        SetSoftkeyText(5,"Salir");
  elsif pantalla = 3 then
        SetSoftkeyText(1,"Velocidad");
        SetSoftkeyText(2,"");
        SetSoftkeyText(3,"");
        SetSoftkeyText(4,"");
   elsif pantalla = PantallaCategoria then
        SetSoftkeyText(1,"Categoria");
        SetSoftkeyText(2,"Aj. Peso");  
        SetSoftkeyText(3,"Met. Pesaje");
        SetSoftkeyText(4,""); 
        SetSoftkeyText(5,"Salir");     
    elsif pantalla = PantallaVelocidad then
        SetSoftkeyText(1,"V. Activ.");
        SetSoftkeyText(2,"T. Piston");  
        SetSoftkeyText(3,"");
        SetSoftkeyText(4,""); 
        SetSoftkeyText(5,"Salir"); 
    elsif pantalla = PantallaCalibracion then
        --InitGranjero;
        --DrawGraphic(1,230,100,g_Granjero,Black);
        SetSoftkeyText(1,"Ini. Prueba");
        SetSoftkeyText(2,"Ter. Prueba");  
        SetSoftkeyText(3,"");
        SetSoftkeyText(4,""); 
        SetSoftkeyText(5,"Salir");
        
        SetLabelText(46, IntegerToString(Basculas[1].Contador, 1));           
    elsif pantalla = 7 then
        --InitGranjero;
        --DrawGraphic(1,230,100,g_Granjero,Black);
        SetSoftkeyText(1,"Bascula");
        SetSoftkeyText(2,"Peso");  
        SetSoftkeyText(3,"Reset");
        SetSoftkeyText(4,""); 
        SetSoftkeyText(5,"Salir");
  end if; 
end;
      

procedure CambiarPantalla(pantalla : integer);
begin
  PantallaAnterior := PantallaActual;
  PantallaActual := pantalla;
  SelectScreen(pantalla);
  ActualizarData(pantalla);
end;                        