handler User1Keypressed;
begin
    --Pantalla 1
    if PantallaActual = PantallaPrincipal then
      CambiarPantalla(PantallaCategoria);  
      
    elsif PantallaActual = 2 then
       PromptN := EntryBascula;
       PromptUser("Bascula: ");  
           
    -- Pantalla 4 ---------------------------------
    elsif PantallaActual = PantallaCategoria then
       PromptN := EntryBascula;
       MenuEntry := MenuCategoria;
       PromptUser("Bascula: "); 
    ------------------------------------------------
                     
    elsif PantallaActual = PantallaVelocidad then
       PromptN := 9;
       PromptUser("V. Activacion: ");    
    elsif PantallaActual = 7 then
       PromptN := 13;
       PromptUser("Bascula");
    else
      DisplayStatus("OtraCosa");
    end if;
end;  

handler User2Keypressed;
begin
     if PantallaActual = 1 then
      CambiarPantalla(PantallaVelocidad);
     elsif PantallaActual = 2 then
      PromptN := 16;
       PromptUser("Bascula: ");  
    
    -- Pantalla 4 ---------------------------------
    elsif PantallaActual = PantallaCategoria then
       PromptN := EntryBascula;
       MenuEntry := MenuPesoPromedio;
       PromptUser("Bascula: "); 
    ------------------------------------------------  
    
    elsif PantallaActual = 5 then
       PromptN := 10;
       PromptUser("T. Piston: ");
    elsif PantallaActual = 7 then
       PromptN := 12;
       PromptUser("Peso Minimo: ");
    else
      DisplayStatus("OtraCosa");
    end if;
end;

handler User3Keypressed;
begin
    if PantallaActual = 1 then
      CambiarPantalla(PantallaCalibracion); 
    elsif PantallaActual = PantallaPruebas then
      CambiarPantalla(PantallaCalibracion);  
     
    -- Pantalla 4 ---------------------------------
    elsif PantallaActual = PantallaCategoria then
       PromptN := EntryCategoriaMinima;
       Basc := 3;
       PromptUser("Rango Minimo: ");
    ------------------------------------------------ 
    
    elsif PantallaActual = 4 then
       PromptN := 5;
       PromptUser("Rango Minimo: "); 
    elsif PantallaActual = 5 then
       PromptN := 17;
       PromptUser("Piston: ");   
    elsif PantallaActual = PantallaCalibracion then
        LimpiarBD;
    elsif PantallaActual = 7 then
      Cantidad := 0;
      PesoPrueba7 := 0;
    else
      DisplayStatus("OtraCosa");
    end if;
end;

handler User4Keypressed;
begin
    if PantallaActual = 1 then
     DisplayStatus("Aun no funciona");
    elsif PantallaActual = 2 then
      PromptN := 18;
      PromptUser("Bascula: ");
    
    -- Pantalla 4 ---------------------------------
    elsif PantallaActual = PantallaCategoria then
       PromptN := EntryCategoriaMinima;
       Basc := 3;
       PromptUser("Rango Minimo: ");
    ------------------------------------------------ 
     
     elsif PantallaActual = 5 then
       PromptN := 14;
       PromptUser("Contador: "); 
    else
      DisplayStatus("OtraCosa");
    end if;
end;

handler User5Keypressed;
begin
    if PantallaActual = 1 then
      cantCategoria1 := 0;
      cantCategoria2 := 0;
      cantCategoria3 := 0;
      cantCategoria4 := 0;  
    elsif PantallaActual = 2 then     
      StopTimer(18);
      CambiarPantalla(PantallaPrincipal);  
    elsif PantallaActual = 3 then
         CambiarPantalla(PantallaPrincipal);
         
         
    ------------Pantalla 4-----------------
    elsif PantallaActual = PantallaCategoria then   
      GuardarCategorias;
      DisplayStatus("Categorias Actualizadas");
      CambiarPantalla(PantallaPrincipal); 
    ------------------------------------------  
    
    elsif PantallaActual = PantallaVelocidad then  
      GuardarPistones;
      DisplayStatus("Pistones Actualizados");  
      CambiarPantalla(PantallaPrincipal);  
      
        
      elsif PantallaActual = 6 then
      CambiarPantalla(PantallaPrincipal);
    elsif PantallaActual = 7 then
      CambiarPantalla(PantallaPrincipal); 
    else
      DisplayStatus("No se Puede Salir");
    end if;
end;           
