type BasculaData is
record
  LecMin : real;
  LecMax : real;
  Bajando : integer;
  Contador : integer;
  EsPrimerLectura : integer; 
  PesoPromedio : real;   
end record;

type BasculasArray is array[4] of BasculaData;

type ConfigData is
record
  VActivacion : integer;
  TActivacion : integer;
  CategoriaMin : real;
  CategoriaMax : real;
  ContadorCat : integer; 
end record;

type ConfigArray is array[4] of ConfigData;    

type RodoData is 
record
    Peso : real;
    Encontrado : real;
end record;

type RodoArray is array [4] of RodoData;
    