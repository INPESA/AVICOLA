procedure ApagarTodosLosPistones;
begin
       
    -- Apagando los BITS EL 1 Se Considera Apagado
    if SetDigout (0, 1, APAGADO) = SysOk then
      DisplayStatus("Apagando el Bit 1"); 
    else
      DisplayStatus("Error");
    end if;   
  
    if SetDigout(0,2,APAGADO) = SysOk then
      DisplayStatus("Apagando el Bit 2");
    else
      DisplayStatus("Error");
    end if; 
  
    if SetDigout(0,3,APAGADO) = SysOk then
     DisplayStatus("Apagando el Bit 3");
    else
      DisplayStatus("Error");
    end if; 
  
    if SetDigout(0,4,APAGADO) = SysOk then
      DisplayStatus("Apagando el Bit 4");
    else
      DisplayStatus("Error");
    end if;
end;    

procedure ApagarTemporizador(Temp : integer);
begin
   StopTimer(Temp);
end;

procedure EncenderTemporizador(Temp : integer);
begin
     Temporizador(Temp, VOn, TimerContinuous, 10);
end;

procedure EncederTodosLosTemporizadores;
begin 
      EncenderTemporizador(1);
      EncenderTemporizador(2);
      EncenderTemporizador(3);
      EncenderTemporizador(4); 
end;       

procedure ApagarTodosLosTemporizadores;
begin 
     StopTimer(1); 
end;

procedure EncenderPiston(piston : integer);
begin
  
  if piston = 1 then
    SetDigout(0,1,ENCENDIDO);
    
  elsif piston = 2 then
    SetDigout(0,2,ENCENDIDO);
    
  elsif piston = 3 then
    SetDigout(0,3,ENCENDIDO);
  
  elsif piston = 4 then
    SetDigout(0,4,ENCENDIDO);
  end if;
end;
       
       
procedure ApagarPiston(piston : integer);
begin                                            
  if piston = 1 then
    SetDigout(0,1,APAGADO);
    
  elsif piston = 2 then
    SetDigout(0,2,APAGADO);
    
  elsif piston = 3 then
    SetDigout(0,3,APAGADO);
  
  elsif piston = 4 then
    SetDigout(0,4,APAGADO);
  end if;
end; 
                                    
procedure BotarPollo(piston: integer);
begin  
   if piston = 1 then  
        Temporizador(Timer1, VOn, TimerOneShot, Config[1].TActivacion);  
        if (Timer1 = 13) then
            Timer1 := 9;   
        else  
            Timer1 := Timer1 + 1;
        end if; 
        
    elsif piston = 2 then
        Temporizador(Timer4, VOn, TimerOneShot, Config[4].TActivacion);  
        if (Timer4 = 28) then
            Timer4 := 24;   
        else  
            Timer4 := Timer4 + 1;
        end if; 
     

  elsif piston = 3 then
        Temporizador(Timer2, VOn, TimerOneShot, Config[2].TActivacion);  
        if (Timer2 = 18) then
            Timer2 := 14;   
        else  
            Timer2 := Timer2 + 1;
        end if;

  elsif piston = 4 then
        Temporizador(Timer3, VOn, TimerOneShot, Config[3].TActivacion);  
        if (Timer3 = 23) then
            Timer3 := 19;   
        else  
            Timer3 := Timer3 + 1;
        end if;
 end if;  
 
end;
                                              
procedure GuardarTarasEnMatriz;
contadores : integer := 1 ;
begin
    BD_Cal.GetFirst; 
    MatrizPesos[1, contadores]  :=  BD_Cal.Peso;
    while(BD_Cal.GetNext <> SysNoSuchRecord or BD_Cal.Rodo < 1)
    loop 
        contadores := contadores + 1;
        MatrizPesos[1, contadores]  :=  BD_Cal.Peso;    
    end loop;
end;  

procedure IniciarCalibracionRodos;
begin            
    Basculas[Basc].Contador := 0;
    Temporizador(19, VOn, TimerContinuous, 10);
end;                               

procedure IniciarCalibracionCero;
begin            
    Basculas[Basc].Contador := 0; 
    DisplayStatus("Cal Basc " + IntegerToString(Basc, 1));
    Temporizador(19, VOn, TimerContinuous, 10);
end; 
                         
                         
procedure IniciarPruebas;
begin      
                                  DisplayStatus("Pruebas Basc " + IntegerToString(Basc, 1));
                                  Temporizador(18, VOn, TimerContinuous, 10);     
                         end;          
                         
                                                 
procedure IniciarPruebasTara;
begin      
                                  DisplayStatus("Pruebas Tara " + IntegerToString(Basc, 1));
                                  Temporizador(20, VOn, TimerContinuous, 10);     
                         end;         
                                       
                
procedure BuscarRodo;
begin        
  Basc := 1;
  EncenderTemporizador(32);
  
end;                       