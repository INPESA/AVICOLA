---------------------- CATEGORIAS ----------------------

procedure CargarCategorias;
i: integer;  
begin
    BD_Categoria.GetFirst;
    for i := 1 to 4 loop  
        Config[i].CategoriaMin := StringToReal(BD_Categoria.Min);
        Config[i].CategoriaMax := StringToReal(BD_Categoria.Max); 
        SetLabelText((0 + i), "Categoria " + IntegerToString(i,1) + " " + BD_Categoria.Min + " " + BD_Categoria.Max);
        BD_Categoria.GetNext;    
    end loop;
end;   

procedure GuardarCategorias;
i: integer;
begin 
    BD_Categoria.Clear;  
    for i := 1 to 4 loop  
        BD_Categoria.Min := RealToString(Config[i].CategoriaMin, 2, 2);
        BD_Categoria.Max := RealToString(Config[i].CategoriaMax, 2, 2);
        BD_Categoria.Add;  
    end loop;
end;    

---------------------- PISTON ----------------------

procedure CargarPistones;
i: integer;
begin
  BD_Piston.GetFirst;
  for i := 1 to 4 loop
    Config[i].TActivacion := BD_Piston.Tiempo;
    Config[i].VActivacion := BD_Piston.Vel;
    SetLabelText((8 + i), "Vel 1: " + IntegerToString(Config[i].VActivacion,2));
    SetLabelText((12 + i), "Tiem 1: " + IntegerToString(Config[i].TActivacion,2));   
    BD_Piston.GetNext;
  end loop;
end;


procedure GuardarPistones;
i: integer;
begin
    BD_Piston.Clear;  
    for i := 1 to 4 loop  
        BD_Piston.Tiempo := Config[i].TActivacion;
        BD_Piston.Vel := Config[i].VActivacion;
        BD_Piston.Add;  
    end loop;
end;
         
---------------------- CONTEOS POR CATEGORIA ----------------------
procedure GuardarContadores;
i : integer;
begin
        BD_Conteo.Fecha := FechaGlobal;
        BD_Conteo.Cat1 := IntegerToString(Config[1].ContadorCat,4);
        BD_Conteo.Cat2 := IntegerToString(Config[2].ContadorCat,4);
        BD_Conteo.Cat3 := IntegerToString(Config[3].ContadorCat,4);
        BD_Conteo.Cat4 := IntegerToString(Config[4].ContadorCat,4);
        BD_Conteo.Add;

        Config[1].ContadorCat := 0;
        Config[2].ContadorCat := 0;
        Config[3].ContadorCat := 0;
        Config[4].ContadorCat := 0;  
end;

procedure CargarContadores;
i : integer;
begin
  for i := 1 to 4 loop
    SetLabelText((41 + i),  IntegerToString(Config[i].ContadorCat,4));
  end loop;
end;

---------------------- PRUEBAS ----------------------      
procedure GuardarEnBD;
begin
    BD_Pruebas.Bascula := Basc;
    BD_Pruebas.Tipo := 1;
    BD_Pruebas.PesoMin := RealToString(Basculas[Basc].LecMin, 2, 3);
    BD_Pruebas.PesoMax := RealToString(Basculas[Basc].LecMax, 2, 3);     
  BD_Pruebas.Add;
end;   

procedure GuardarEnBDconTara(BasculaNum : integer; Tipo : integer);
begin
    BD_Pruebas.Bascula := Basc;
    BD_Pruebas.Tipo := 2;
    BD_Pruebas.PesoMin := RealToString(Basculas[Basc].LecMin, 2, 3);
    BD_Pruebas.PesoMax := RealToString(Basculas[Basc].LecMax - MatrizPesos[1, Basculas[Basc].Contador],2, 3);     
  BD_Pruebas.Add;
end;      

procedure LimpiarBD;
begin
    BD_Pruebas.Clear;
end;    