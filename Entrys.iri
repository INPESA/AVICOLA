handler Userentry;
--Declaration Section
s : string;
begin
    if EnterKey = EventKey then
      s := GetEntry;  
      
    ------------------------------Principal------------------------    
    if PromptN = EntryBascula then
            Basc := StringToInteger(s);   
            ClosePrompt;                                       
            DisplayStatus(IntegerToString(Basc,1));
            
            if MenuEntry = MenuCategoria then
                PromptN := EntryCategoriaMinima;
                PromptUser("Rango Minimo: ");  
            elsif MenuEntry = MenuPesoPromedio then
                PromptN := EntryPesoPromedio;
                PromptUser("Peso Promedio: "); 
            elsif MenuEntry = MenuVActivacion then
                PromptN := EntryVActivacion;
                PromptUser("Vel. Activacion: ");
            elsif MenuEntry = MenuTActivacion then
                PromptN := EntryTActivacion;
                PromptUser("T. Activacion: ");
            end if;              
   ------------------------------------------------------------------------     
    
    --Ajuste de Categoria Minima       
    elsif PromptN = EntryCategoriaMinima then
      Config[Basc].CategoriaMin := StringToReal(s);
      ClosePrompt;
      PromptN := EntryCategoriaMaxima;
      PromptUser("Rango Maximo: ");
    --------------------------------------
    
    --Ajuste de Categoria Maxima
    elsif PromptN = EntryCategoriaMaxima then
      Config[Basc].CategoriaMax := StringToReal(s); 
      ClosePrompt;         
      SetLabelText((0 + Basc), "Categoria " + IntegerToString(Basc,1) + " " + RealToString(Config[Basc].CategoriaMin,2,2) + " " + RealToString(Config[Basc].CategoriaMax,2,2));
    ----------------------------------------------
    
    --------------------Ajuste de Peso Promedio  
    elsif PromptN = EntryPesoPromedio then
        Basculas[Basc].PesoPromedio := StringToReal(s); 
        ClosePrompt; 
          
    elsif PromptN = EntryVActivacion then
        Config[Basc].VActivacion := StringToReal(s); 
        ClosePrompt;         
        SetLabelText((8 + Basc), "Vel 1: " + IntegerToString(Config[Basc].VActivacion,2));
            
    elsif PromptN = EntryTActivacion then
        Config[Basc].TActivacion := StringToReal(s); 
        ClosePrompt;         
        SetLabelText((12 + Basc), "Tiem 1: " + IntegerToString(Config[Basc].TActivacion,2));
      
    elsif PromptN = 7 then
      DisplayStatus("Vacio");
    elsif PromptN = 8 then
      DisplayStatus("Vacio");
      
    elsif PromptN = 9 then
      Velocidad := StringToInteger(s);
      ClosePrompt; 
      CambiarPantalla(PantallaVelocidad);
    elsif PromptN = 10 then
      Accion := StringToInteger(s);
      ClosePrompt;
      CambiarPantalla(PantallaVelocidad);
    elsif PromptN = 11 then
      Contrasena := StringToInteger(s);
      ClosePrompt;    
    elsif PromptN = 12 then
      MinPrueba := StringToInteger(s);
      ClosePrompt;  
    elsif PromptN = 13 then
      Bascula := StringToInteger(s);
      ClosePrompt; 
    elsif PromptN = 14 then
      Basculas[1].Contador := StringToInteger(s);
      ClosePrompt;   
    elsif PromptN = 15 then
      Basc := StringToInteger(s);
      ClosePrompt; 
      ApagarTodosLosTemporizadores;   
      IniciarCalibracionCero;
    elsif PromptN = 16 then
      Basc := StringToInteger(s);
      ClosePrompt;       
      ApagarTodosLosTemporizadores; 
      IniciarCalibracionRodos;
    elsif PromptN = 17 then     
        BotarPollo(StringToInteger(s));  
        ClosePrompt;          
    elsif PromptN = 18 then
       
       Basc := StringToInteger(s);   
       ClosePrompt;                         
              
       DisplayStatus(IntegerToString(Basc,1)); 
              
       ApagarTodosLosTemporizadores; 
                                    
       IniciarPruebas; 
    end if;   
    end if;
end;
